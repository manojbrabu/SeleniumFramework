<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>

    <test name="Login Test" enabled="true">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="Add User Test" enabled="true">
        <parameter name="browser" value="chrome"/>
        <parameter name="userName" value="Manoj12345"/>
        <classes>
            <class name="tests.AddUserTest"/>
        </classes>
    </test>

    <test name="Search User Test" enabled="true">
        <parameter name="browser" value="firefox"/>
        <parameter name="username" value="Manoj12345"/>
        <classes>
            <class name="tests.SearchUser"/>
        </classes>
    </test>
</suite>

